# 떠나요 프런트엔드 로컬 환경변수 예시
# 같은 폴더에 .env.local로 복사해 사용하세요.
# 값을 입력하고 개발 서버를 다시 시작하면 네이버 지도가 표시됩니다.
# 네이버클라우드 Maps Application에 http://localhost 등 접속 주소를 등록해야 합니다.

# 네이버클라우드 Maps Web Dynamic Map의 Client ID
# Client Secret, 지역 검색 API Secret 등 비밀키는 이 파일이나 VITE_ 변수에 넣지 마세요.
VITE_NAVER_MAPS_CLIENT_ID=

# 로컬에서는 생략 가능(기본값 http://localhost:4000).
# Vercel 프로젝트에는 Railway 백엔드의 공개 HTTPS 주소를 설정하세요.
VITE_API_BASE_URL=http://localhost:4000
