# 떠나요 서버 환경변수 예시
# 사용법: 이 파일을 같은 폴더의 .env로 복사한 뒤 필요한 값만 입력하세요.
# .env에는 실제 비밀키를 넣고 공유하거나 업로드하지 마세요.
# 아래 '예정' 항목은 키를 입력해도 현재 코드에서 사용되지 않습니다.

# [현재 사용] Express 서버 포트. 프런트엔드는 현재 localhost:4000을 호출합니다.
PORT=4000

# [현재 사용] 로그인 JWT 서명 비밀값. 운영 환경에서는 반드시 길고 무작위인 값으로 설정하세요.
# 로컬 개발에서는 비워 두면 서버가 개발용 키를 생성해 로컬 DB에 저장합니다.
JWT_SECRET=

# [현재 사용, 선택] lowdb 저장 파일 경로. 비우면 서버 폴더의 tteonayo.json을 사용합니다.
# TTEONAYO_DB_PATH=

# [연결 예정] 카카오 로컬/장소 검색 REST API 키.
# 현재는 OpenStreetMap/Overpass를 사용하며, 카카오 응답 변환 함수만 준비돼 있습니다.
# 키를 넣는 것만으로 카카오 장소 검색이 작동하지 않습니다. 서버 검색 API 구현이 필요합니다.
# KAKAO_REST_API_KEY=

# [연결 예정] OpenAI API 키. AI 채팅·장소 추천·방문 순서 제안은 아직 실제 AI와 연결되지 않았습니다.
# 반드시 서버에서만 사용하고 React/Vite 프런트엔드 코드에 넣지 마세요.
# OPENAI_API_KEY=

# [제공처 선정 후 연결] 숙소 평균 가격 데이터용 키.
# Airbnb 사용을 계획 중이지만 현재 제공처/API 계약과 실제 연동은 확정되지 않았습니다.
# 제공처가 정해지면 해당 서비스의 변수 이름과 서버 요청 코드를 추가하세요.
# LODGING_API_KEY=

# [제공처 선정 후 연결] 관광지 혼잡도와 도보·대중교통·자동차 이동시간 데이터.
# 현재 실제 혼잡도/경로 조회 API는 없고, 화이트보드 이동시간은 사용자가 직접 입력합니다.
# CONGESTION_API_KEY=
# ROUTING_API_KEY=

# [향후 저장소 전환 시] Supabase PostgreSQL/Storage 연결 정보.
# 현재 데이터는 lowdb에 저장되며 Supabase 코드는 연결되어 있지 않습니다.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# [현재 키 불필요] Open-Meteo 날씨·지오코딩, OpenStreetMap/Overpass 장소 조회.
