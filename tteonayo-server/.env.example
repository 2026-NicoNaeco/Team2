# 떠나요 서버 환경변수 예시
# 이 파일을 .env로 복사한 뒤 필요한 값을 입력하세요. 실제 키는 공유하거나 업로드하지 마세요.

# 로컬 서버 포트. Vercel에서는 VITE_API_BASE_URL로 Railway 주소를 지정합니다.
PORT=4000

# Railway에서는 Supabase 대시보드 Connect의 Session pooler PostgreSQL URI를 입력하세요.
# 주소에 sslmode=require를 포함하고 프런트엔드에는 절대 노출하지 마세요.
DATABASE_URL=

# Railway에서는 Vercel 프런트엔드의 정확한 HTTPS 출처를 입력하세요. 여러 출처는 쉼표로 구분합니다.
CLIENT_ORIGINS=http://localhost:5173

# Railway에서 필수. 로컬 JSON 저장 모드에서는 비우면 개발용 키를 생성합니다.
JWT_SECRET=

# 계정 비밀번호 재설정 메일: Resend에서 인증한 발신 도메인과 API 키를 서버에만 설정하세요.
# 미설정 시 재설정 요청은 503으로 안내하며 계정 삭제·이메일 찾기는 계속 동작합니다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 메일 링크가 열 프런트엔드 주소 (로컬: http://localhost:5173, 배포: Vercel HTTPS 주소)
APP_PUBLIC_URL=http://localhost:5173

# 챗봇 답변과 숙소 추천 웹 검색에 사용합니다. 서버에만 입력하세요.
OPENAI_API_KEY=
# 선택. 비우면 gpt-4.1-mini를 사용합니다.
# OPENAI_MODEL=gpt-4.1-mini

# 네이버클라우드 NAVER API HUB에서 '검색 > 지역' 앱을 등록한 경우 아래 두 값을 사용합니다.
# Maps 앱과는 별도 앱/키입니다. 두 검색 키 방식 모두 입력하면 API HUB를 우선 사용합니다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# 네이버 Developers의 '검색 > 지역' 앱을 사용한다면 이 두 값을 대신 입력하세요.
# Maps 키나 네이버클라우드 계정의 일반 Access Key/Secret Key를 넣는 칸이 아닙니다.
# 검색 키가 없으면 이름 검색은 기존 OpenStreetMap 데이터로 동작합니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 서울 관광지 실시간 혼잡도에 사용하는 서울 열린데이터광장 OpenAPI 인증키입니다.
SEOUL_CITYDATA_API_KEY=
# 선택. 기본 요청 주소를 바꿔야 할 때만 사용하며 {key}, {place}를 유지하세요.
# SEOUL_CITYDATA_API_URL=http://openapi.seoul.go.kr:8088/{key}/xml/citydata/1/5/{place}

# 로컬 JSON 저장 모드에서만 사용합니다. 비우면 서버 폴더의 tteonayo.json에 저장합니다.
# TTEONAYO_DB_PATH=
